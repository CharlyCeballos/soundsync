<?xml version="1.0" encoding="utf-8"?>
<!--
  Soundsync GUI installer, built by wixl (msitools) in build/package.sh.
  Per-user: installs to %LOCALAPPDATA%\Programs\Soundsync without admin
  rights, adds a Start menu shortcut, and a newer version replaces the old
  one (MajorUpgrade). Uninstall removes everything it installed; the user's
  settings in %APPDATA%\soundsync are theirs and stay.

  Never change UpgradeCode: it is how Windows knows a new version replaces
  the installed one. MSI compares only the first three version fields.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Soundsync" Language="1033" Version="$(var.Version)"
           Manufacturer="Carlos Ceballos" UpgradeCode="23819802-A721-47CA-8469-4346CB76537D">
    <!-- wixl takes the architecture from -a x64 and the no-admin install from
         InstallScope; it has no InstallPrivileges or Platform attributes. -->
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="Soundsync" Comments="Copy your Spotify playlists to YouTube" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Soundsync is already installed." />
    <Media Id="1" Cabinet="soundsync.cab" EmbedCab="yes" />

    <Icon Id="SoundsyncIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SoundsyncIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/CharlyCeballos/soundsync" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Soundsync">
            <Component Id="App" Guid="1A229D97-BEC7-4E6C-87C3-12204D300E79" Win64="yes">
              <File Id="Exe" Name="soundsync-gui.exe" Source="$(var.ExePath)" />
              <File Id="License" Name="LICENSE.txt" Source="$(var.LicensePath)" />
              <File Id="Notice" Name="THIRD-PARTY-NOTICE.md" Source="$(var.NoticePath)" />
              <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
              <!-- A per-user component needs a per-user key path. -->
              <RegistryValue Root="HKCU" Key="Software\Soundsync" Name="app" Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="Shortcut" Guid="CD0A0B50-65DC-4E42-B9DB-ED74DB790C0F" Win64="yes">
          <Shortcut Id="StartMenuShortcut" Name="Soundsync" Description="Copy your Spotify playlists to YouTube"
                    Target="[INSTALLDIR]soundsync-gui.exe" WorkingDirectory="INSTALLDIR" />
          <RegistryValue Root="HKCU" Key="Software\Soundsync" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="Soundsync" Level="1">
      <ComponentRef Id="App" />
      <ComponentRef Id="Shortcut" />
    </Feature>
  </Product>
</Wix>
